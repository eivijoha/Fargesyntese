{
  "sourceLanguage": "nb",
  "strings": {
    "Aksent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accent"
          }
        }
      }
    },
    "Aksent fra «%@». Brukes sparsomt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accent from “%@”. Use sparingly."
          }
        }
      }
    },
    "Analog": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analogous"
          }
        }
      }
    },
    "Andre farge i triaden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Second colour of the triad."
          }
        }
      }
    },
    "Apple Intelligence er ikke tilgjengelig (%@). Leksikonet brukes i stedet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is not available (%@). The built-in lexicon is used instead."
          }
        }
      }
    },
    "Apple Intelligence er klar. Alt skjer på enheten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is ready. Everything happens on device."
          }
        }
      }
    },
    "Apple Intelligence støtter ikke språket ditt på denne enheten ennå. Leksikonet brukes i stedet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence doesn't support your language on this device yet. The built-in lexicon is used instead."
          }
        }
      }
    },
    "Apple Intelligence svarte ikke (%@). Forslaget under er fra det innebygde leksikonet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence didn't respond (%@). The suggestion below is from the built-in lexicon."
          }
        }
      }
    },
    "Bakgrunn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background"
          }
        }
      }
    },
    "Bruk «Mer kontrast» eller legg til sort/hvit tekstfarge.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “More contrast” or add a black/white text colour."
          }
        }
      }
    },
    "Bygget fra kunnskapsbasen: %@%@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built from the knowledge base: %1$@%2$@."
          }
        }
      }
    },
    "Denne enheten støtter ikke Apple Intelligence. Kolorist bruker den innebygde kunnskapsbasen i stedet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device doesn't support Apple Intelligence. Kolorist uses the built-in knowledge base instead."
          }
        }
      }
    },
    "Fant ingen kjente verdiord – her er et nøytralt utgangspunkt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No known value words found – here is a neutral starting point."
          }
        }
      }
    },
    "Fargene kan skilles også med rød-grønn fargesynsavvik.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The colours can be told apart even with red-green colour vision deficiency."
          }
        }
      }
    },
    "Fargepar som består WCAG AA for tekst (4,5:1): %lld av %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colour pairs passing WCAG AA for text (4.5:1): %lld of %lld"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "new",
            "value": "Fargepar som består WCAG AA for tekst (4,5:1): %1$lld av %2$lld"
          }
        }
      }
    },
    "Fargesyn – %@: %lld fargepar blir vanskelige å skille: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colour vision – %1$@: %2$lld colour pairs become hard to tell apart: %3$@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "new",
            "value": "Fargesyn – %1$@: %2$lld fargepar blir vanskelige å skille: %3$@"
          }
        }
      }
    },
    "Fargesyn: alle fargepar kan skilles med protanopi, deuteranopi, tritanopi og akromatopsi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colour vision: all colour pairs can be told apart with protanopia, deuteranopia, tritanopia and achromatopsia."
          }
        }
      }
    },
    "Fra «%@».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From “%@”."
          }
        }
      }
    },
    "God spredning i lyshet gir tydelig hierarki.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good spread in lightness gives a clear hierarchy."
          }
        }
      }
    },
    "Hovedfarge for verdiordene.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Main colour for the value words."
          }
        }
      }
    },
    "Hovedfarge fra «%@».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Main colour from “%@”."
          }
        }
      }
    },
    "Hovedkuløren på sitt klareste, som aksent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main hue at its clearest, as accent."
          }
        }
      }
    },
    "Ingen fargepar når 4,5:1 – paletten egner seg ikke til tekst alene.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No colour pair reaches 4.5:1 – the palette is not suitable for text on its own."
          }
        }
      }
    },
    "Komplementær": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complementary"
          }
        }
      }
    },
    "Komplementær aksent fra «%@». Brukes sparsomt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complementary accent from “%@”. Use sparingly."
          }
        }
      }
    },
    "Komplementær aksent. Brukes sparsomt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complementary accent. Use sparingly."
          }
        }
      }
    },
    "Kulører:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hues:"
          }
        }
      }
    },
    "Legg til en tydelig lys og en tydelig mørk farge.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a clearly light and a clearly dark colour."
          }
        }
      }
    },
    "Lik metning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Equal saturation"
          }
        }
      }
    },
    "Lik valør": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Equal value"
          }
        }
      }
    },
    "Lite spenn i lyshet gjør det vanskelig å skape kontrast.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little spread in lightness makes contrast hard to achieve."
          }
        }
      }
    },
    "Lys": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light"
          }
        }
      }
    },
    "Lys bakgrunn med et hint av hovedfargen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light background with a hint of the main colour."
          }
        }
      }
    },
    "Lyshetsspenn (OKLCH): %@–%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightness range (OKLCH): %@–%@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "new",
            "value": "Lyshetsspenn (OKLCH): %1$@–%2$@"
          }
        }
      }
    },
    "Minst ett fargepar kan brukes til brødtekst (WCAG AA).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one colour pair can be used for body text (WCAG AA)."
          }
        }
      }
    },
    "Modellen er opptatt med en annen forespørsel. Prøv igjen om et øyeblikk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model is busy with another request. Try again in a moment."
          }
        }
      }
    },
    "Modellen ville ikke svare på denne forespørselen. Prøv å formulere den annerledes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model wouldn't answer this request. Try phrasing it differently."
          }
        }
      }
    },
    "Monokrom": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monochrome"
          }
        }
      }
    },
    "Mørk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark"
          }
        }
      }
    },
    "Mørk bakgrunn med et hint av hovedfargen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark background with a hint of the main colour."
          }
        }
      }
    },
    "Nabokulør til hovedfargen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neighboring hue to the main colour."
          }
        }
      }
    },
    "Noen fargepar blir vanskelige å skille med rød-grønn fargesynsavvik (rundt 8 % av menn).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some colour pairs become hard to tell apart with red-green colour vision deficiency (about 8 % of men)."
          }
        }
      }
    },
    "Noen farger er utenfor sRGB; kontroller dem på en vanlig skjerm og i trykk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some colours are outside sRGB; check them on a regular display and in print."
          }
        }
      }
    },
    "Nøytral start": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neutral start"
          }
        }
      }
    },
    "Primær": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Primary"
          }
        }
      }
    },
    "Regelbasert vurdering (Apple Intelligence er ikke tilgjengelig).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rule-based critique (Apple Intelligence is not available)."
          }
        }
      }
    },
    "Regelbasert vurdering (Apple Intelligence feilet: %@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rule-based critique (Apple Intelligence failed: %@)."
          }
        }
      }
    },
    "Rolig tone til flater og rammer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet tone for surfaces and borders."
          }
        }
      }
    },
    "Samtalen ble for lang for modellen. Start et nytt forslag.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversation got too long for the model. Start a new suggestion."
          }
        }
      }
    },
    "Sekundær": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondary"
          }
        }
      }
    },
    "Skill fargene som forveksles med tydelig forskjell i lyshet, eller bruk ikon, mønster eller tekst i tillegg til farge.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate the colours that get confused with a clear difference in lightness, or add an icon, pattern or text in addition to colour."
          }
        }
      }
    },
    "Slå på Apple Intelligence i Innstillinger for å få KI-forslag. Inntil da brukes det innebygde leksikonet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Apple Intelligence in Settings to get AI suggestions. Until then, the built-in lexicon is used."
          }
        }
      }
    },
    "Splittkomplementær": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split complementary"
          }
        }
      }
    },
    "Splittkomplementær aksent. Brukes sparsomt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split-complementary accent. Use sparingly."
          }
        }
      }
    },
    "Splittkomplementær til hovedfargen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split complementary to the main colour."
          }
        }
      }
    },
    "Språkmodellen feilet: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language model failed: %@"
          }
        }
      }
    },
    "Språkmodellen lastes ned eller gjøres klar. Prøv igjen om litt – leksikonet brukes så lenge.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language model is downloading or getting ready. Try again shortly – the lexicon is used meanwhile."
          }
        }
      }
    },
    "Støtte": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support"
          }
        }
      }
    },
    "Støttefarge i samme harmoni.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supporting colour in the same harmony."
          }
        }
      }
    },
    "Tekst": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text"
          }
        }
      }
    },
    "Tekst med %@ kontrast mot bakgrunnen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text with %@ contrast against the background."
          }
        }
      }
    },
    "Tone i tone med hovedfargen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tone on tone with the main colour."
          }
        }
      }
    },
    "Tredje farge i triaden, som aksent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Third colour of the triad, as accent."
          }
        }
      }
    },
    "Triade": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Triad"
          }
        }
      }
    },
    "Utenfor sRGB (bare P3-skjermer viser riktig):": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside sRGB (only P3 displays show it correctly):"
          }
        }
      }
    },
    "ingen (kun nøytrale)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "none (neutrals only)"
          }
        }
      }
    }
  },
  "version": "1.0"
}
