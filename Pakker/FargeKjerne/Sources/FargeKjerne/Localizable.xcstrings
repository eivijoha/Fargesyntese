    "Kunstnersirkelen med rød, gul og blå som primærfarger. Blå er komplementær til oransje.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The artist's wheel with red, yellow and blue as primaries. Blue is complementary to orange."
          }
        }
      }
    },
    "Lab-basert sirkel, som i Photoshop og fargemåling. Lyshet og kroma holdes fast.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lab-based wheel, as in Photoshop and color measurement. Lightness and chroma are kept fixed."
          }
        }
      }
    },
