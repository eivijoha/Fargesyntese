    "Perseptuelt like vinkler, og lyshet og metning holdes fast, så fargene veier likt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perceptually even angles, with lightness and saturation kept fixed so the colors carry equal weight."
