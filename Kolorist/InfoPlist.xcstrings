    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolorist uses the camera to pick colours from your surroundings and to show them as they look with colour vision deficiencies."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolorist bruker kameraet til å plukke farger fra omgivelsene dine og til å vise dem slik de ser ut med fargesynsavvik."
          }
        }
      }
