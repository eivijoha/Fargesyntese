      }
    },
    "Velg grunnfarge fra lagrede farger": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose base colour from saved colours"
          }
        }
      }
    },
    "Velges under «Vis også» i Studio: høyre halvdel viser nærmeste tone i biblioteket, og «Begrens nye farger» låser farger, toner og harmonier til bibliotekets toner.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chosen under “Also show” in Studio: the right half shows the nearest tone in the library, and “Limit new colours” locks colours, tones and harmonies to the library’s tones."
          }
        }
      }
    },
    "Verdier": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values"
          }
        }
      }
    },
    "Verdier for denne profiltypen hentes fra aktiv farge.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values for this profile type are taken from the active colour."
