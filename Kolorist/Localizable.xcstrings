    "ΔE00 %@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ΔE00 %@ · %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "new",
            "value": "ΔE00 %1$@ · %2$@"
          }
        }
      }
    },
    "ΔE00 %@ → %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ΔE00 %1$@ → %2$@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "new",
            "value": "ΔE00 %1$@ → %2$@"
          }
        }
      }
    },
    "ΔE00 måler avviket fra kildefargen. Hensiktene skiller seg bare når profilene har egne tabeller for dem, typisk CMYK-profiler fra trykkerier; rene matriseprofiler som sRGB og Display P3 gir samme svar for alle.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ΔE00 measures the deviation from the source color. The intents only differ when the profiles have their own tables for them, typically CMYK profiles from print shops; pure matrix profiles like sRGB and Display P3 give the same result for all."
          }
        }
      }
    }
  },
  "version": "1.0"
}
