    "Aktiv farge testes som tekst/grafikk mot bakgrunnen. «Rett opp» endrer bare lysheten, og beholder kulør og metning.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The active color is tested as text/graphics against the background. “Fix” changes only the lightness, keeping hue and saturation."
          }
        }
      }
    },
